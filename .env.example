# Copy to `.env` in this directory. Never commit real values.

# GRIDGO API origin used by /support and /desk.
# Production default: https://gridgo-api.talasora.com  (no trailing /api)
# Local: /api  (Vite proxies to :8787 without stripping /api)
#    or the API origin directly.
VITE_API_URL=

# Same GRIDGO Clerk instance as the dashboard. Publishable key only.
# The desk at /desk accepts gridgo26@gmail.com and no other account.
VITE_CLERK_PUBLISHABLE_KEY=
